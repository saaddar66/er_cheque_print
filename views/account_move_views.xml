<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_er_cheque_print" model="ir.ui.view">
        <field name="name">account.move.form.inherit.er_cheque_print</field>
        <field name="model">account.move</field>
        <!-- Assuming the base view is account.view_move_form, we append to its header -->
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_internal_transfer_journal" invisible="1"/>
                <button name="action_open_jv_cheque_wizard" 
                        string="Print Cheque" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="state != 'posted' or move_type != 'entry' or not is_internal_transfer_journal"/>
            </xpath>
        </field>
    </record>
</odoo>
