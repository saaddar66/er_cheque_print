<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_payment_form_cheque_print" model="ir.ui.view">
        <field name="name">account.payment.form.cheque.print</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_cheque_print_wizard"
                        string="Print Cheque"
                        type="object"
                        class="btn-primary"
                        invisible="payment_type != 'outbound' or state != 'in_process'"/>
                </xpath>
        </field>
    </record>


    <record id="action_bulk_print_cheques" model="ir.actions.server">
        <field name="name">Bulk Print Cheques</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_open_bulk_cheque_print_wizard()
        </field>
    </record>

    <record id="view_cheque_print_wizard_form" model="ir.ui.view">
        <field name="name">cheque.print.wizard.form</field>
        <field name="model">cheque.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Cheque">
                <group>
                    <group string="Cheque Details">
                        <field name="payment_id" readonly="1"/>
                        <field name="layout_id"/>
                        <field name="cheque_book_id"/>
                        <field name="leaf_id"/>
                        <field name="payee_name"/>
                        <field name="amount" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="cheque_date" readonly="1"/>
                        <field name="memo"/>
                        <field name="is_ac_payable" widget="boolean_toggle"/>
                        <field name="amount_words" readonly="1"/>
                    </group>
                    <group string="Bank Details">
                        <field name="bank_name"/>
                        <field name="bank_account_number"/>
                        <field name="bank_email"/>
                        <field name="bank_address"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>