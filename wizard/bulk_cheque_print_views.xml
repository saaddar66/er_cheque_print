<odoo>

    <record
        id="view_bulk_cheque_print_wizard_form"
        model="ir.ui.view"
    >
        <field name="name">bulk.cheque.print.wizard.form</field>
        <field name="model">bulk.cheque.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Print Cheques">
                <sheet>
                    <group>
                        <group>
                            <field name="layout_id"/>
                            <field name="cheque_book_id"/>
                            <field name="cheque_date"/>
                        </group>
                        <group>
                            <field name="payment_count" readonly="1"/>
                            <field name="available_leaf_count" readonly="1"/>
                            <field name="is_ac_payable"/>
                        </group>
                    </group>

                    <group>
                        <field name="memo"/>
                    </group>

                    <group string="Payments">
                        <field
                            name="payment_ids"
                            widget="many2many_tags"
                            readonly="1"
                        />
                    </group>
                </sheet>

                <footer>
                    <button
                        name="action_print_bulk_cheques"
                        string="Print Cheques"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

</odoo>